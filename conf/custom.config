/*
 * -------------------------------------------------
 *  Nextflow config file for processes options
 * -------------------------------------------------
 * Defines general paths for input files and
 * parameters for your own analysis
 */

params {
    /*
    *General parameters
    */
    // Analyzed project name
    projectName = "MetaLoRe"

    // Output directory to publish workflow results
    outdir = "${baseDir}/results/${projectName}"
    resultdir = "${outdir}/02_results"

    // ONT raw data
    datadir = "/scratch/cpoisson/PROJET_ANSES_2026_scratch/MetaLoRe/data/"
    ONT_path = "${datadir}SRR11673984.fastq.gz"

    // Nanofilt parameters
    length_min = 500
    quality = 10

    // Reference genome Minimap2
    ref_genome = "${datadir}all.fasta"

    // Kraken2 database
    db_kraken = "/db/kraken2/kraken2_2025-10-15/k2_pluspf_16_GB_20251015/"

    // Flye output directory
    //flye_out = "${resultdir}/5-assembly/1-flye/flye_out/*.fasta"

    // Medaka model 
    model_medaka = "r1041_e82_400bps_hac_v4.2.0"

    // Environnement SemiBin
    env_semibin = "global"

    // Checkm2 database
    db_checkm2 = "${baseDir}/databases/CheckM2_database/uniref100.KO.1.dmnd"

    // Abricate databases
    db2_abricate = "megares"
    db3_abricate = "card"
    db4_abricate = "plasmidfinder"
    db5_abricate = "resfinder"

    // Phylophlan database and diversity
    db_phylophlan = "phylophlan"
    diversity_phylophlan = "low"
    config_phylophlan = "${baseDir}/databases/supermatrix_aa.cfg"
    input_folder = "input/"
    extension_input = ".faa.gz"

    // Megares database for Blast
    db_megares_path = "${baseDir}/databases/megares_database_v3.00.fasta"
    db_megares_type = "nucl"
    megares_db = "${baseDir}/databases/megares_database_v3"

    // MobileOG database for Blast
    db_mobileOG_path = "${baseDir}/databases/mobileOG-db_beatrix-1.6.faa"
    db_mobileOG_type = "prot"
    mobileOG_db = "${baseDir}/databases/mobileOG-db"

    // Plasmidfinder database for Blast
    db_plasmidfinder_path = "${baseDir}/databases/plasmidfinder_db/plasmidfinder_all.fasta" 
    db_plasmidfinder_type = "nucl"
    plasmidfinder_db = "${baseDir}/databases/plasmidfinder_db/plasmidfinder_all_db"

    // Gtdbtk database
    gtdbtk_db = "/db/"
}
