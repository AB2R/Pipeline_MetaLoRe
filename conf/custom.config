/*
 * -------------------------------------------------
 *  Nextflow config file for processes options
 * -------------------------------------------------
 * Defines general paths for input files and
 * parameters for your own analysis
 */

params {
    /*
    *General parameters
    */
    // Analyzed project name
    projectName = "MetaLoRe"

    // Output directory to publish workflow results
    outdir = "${baseDir}/results/${projectName}"
    resultdir = "${outdir}/02_results"

    // ONT raw data
    datadir = "/scratch/cpoisson/PROJET_ANSES_2026_scratch/MetaLoRe/data/"
    ONT_path = "${datadir}*.fastq.gz"

    // Nanofilt parameters
    length_min = 500
    quality = 10

    // Reference genome Minimap2
    reference_genome = "/db/ncbi/genomes/H_sapiens/Homo_sapiens-ncbi_GRCh38.p13/fasta/all.fasta"
}
