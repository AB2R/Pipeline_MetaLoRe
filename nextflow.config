// Load processes parameters
includeConfig 'conf/base.config'
// Load resources configuration
includeConfig 'conf/resources.config'

manifest {
    name = 'MetaLoRe'
    author = 'Poisson Clementine'
    description = ''
    homePage = ''
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = ''
}

// Define env variable that will be accessible in nextflow tasks
env {
    WDir = "${SCRATCH}"
}

// Execution profiles
profiles {
    custom {
        includeConfig 'conf/custom.config'
        includeConfig 'conf/reports.config'
        // Workdir for temporary data
        workDir = '/scratch/cpoisson/PROJET_ANSES_2026_scratch/MetaLoRe/work'
    }

    genouest {
	includeConfig 'genouest.config'
	includeConfig 'conf/custom.config'
        includeConfig 'conf/reports.config'
    }

    singularity {
        docker.enabled = false
        singularity.autoMounts = true
        singularity.enabled = true
        process {
             withName : nanoplot {
                container = "quay.io/biocontainers/nanoplot:1.28.4--py_0"
            }
	     withName : porechop_abi {
		container = "quay.io/biocontainers/porechop_abi:0.5.1--py310h275bdba_0"
		env.HOME = '$PWD'
	    }
	     withName : nanofilt {
		container = "quay.io/biocontainers/nanofilt:1.1.3--py35_0"
	    }
	     withName : minimap2_1 {
		container = "quay.io/biocontainers/minimap2:2.30--h577a1d6_0"
	    }
	     withName : samtools_1 {
		container = "quay.io/biocontainers/samtools:1.23--h96c455f_0"
	    }
	     withName : bedtools {
		container = "quay.io/biocontainers/bedtools:2.27.1--h077b44d_9"
	    }
	     withName : kraken2 {
		container = "quay.io/biocontainers/kraken2:2.17.1--pl5321h077b44d_0"
	    }
	     withName : seqkit {
		container = "quay.io/biocontainers/seqkit:2.12.0--he881be0_1"
	    }
	     withName : flye {
		container = "quay.io/biocontainers/flye:2.9.6--py310h275bdba_0"
	    }
	     withName : minimap2_2 {
		container = "quay.io/biocontainers/minimap2:2.30--h577a1d6_0"
	    }
	     withName : racon_1 {
		container = "quay.io/biocontainers/racon:1.5.0--h077b44d_6"
	    }
	     withName : minimap2_3 {
		container = "quay.io/biocontainers/minimap2:2.30--h577a1d6_0"
	    }
	      withName : racon_2 {
                container = "quay.io/biocontainers/racon:1.5.0--h077b44d_6"
            }
	      withName : minimap2_4 {
                container = "quay.io/biocontainers/minimap2:2.30--h577a1d6_0"
            }
	      withName : samtools_2 {
                container = "quay.io/biocontainers/samtools:1.23--h96c455f_0"
            }
	     withName : medaka {
		container = "docker://ontresearch/medaka:shacf8338462607b17b1d68dbce212cb93daea50bad"
	    }
	     withName : quast {
		container = "quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2"
	    }
	     withName : semibin {
		container = "quay.io/biocontainers/semibin:2.2.1--pyhdfd78af_0"
